{
  "expo": {
    "name": "BeakBuddy: Parrot Training AI",
    "slug": "beakbuddy",
    "scheme": "beakbuddy",
    "version": "1.2.8",
    "orientation": "portrait",
    "icon": "./logo-png.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beakbuddy.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "BeakBuddy needs camera access to scan food items for safety information.",
        "NSMicrophoneUsageDescription": "BeakBuddy needs microphone access for the Talk & Repeat feature.",
        "NSSpeechRecognitionUsageDescription": "BeakBuddy uses speech recognition for interactive features.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./logo-png.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.beakbuddy.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BeakBuddy to access your camera to scan food items."
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "ce05eba6-7504-4253-8b9e-089950e2e3c5"
      }
    }
  }
}